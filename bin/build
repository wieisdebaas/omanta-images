# Photo view twee pagina's:
#
#   * .qml/ — qml only, can be compiled stand-alone (with -id <path>)
#   * src/  — C++ implementation
#
# Works from any directory: `./bin/build && ./bin/install`.

# Build and install are separate because you can rebuild without reinstalling
# (the installed symlink points at build/omanta), but install always does a
# clean build first so it never carries stale object files.

set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
BUILD_DIR="$ROOT/build"

# ---- clean build so stale object files never survive a reinstall ----
rm -rf "$BUILD_DIR"

cmake -S "$ROOT" -B "$BUILD_DIR" -G Ninja \
  -DCMAKE_BUILD_TYPE="${OMANTA_BUILD_TYPE:-Debug}" \
  -DCMAKE_INSTALL_PREFIX=/usr

cmake --build "$BUILD_DIR"

echo "Built $BUILD_DIR/omanta"
